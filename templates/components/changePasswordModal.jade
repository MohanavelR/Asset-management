#changePasswordModal.modal.fade(tabindex="-1", aria-hidden="true")
  .modal-dialog
    .modal-content
      form#changePasswordForm(novalidate)
        .modal-header
          h5.modal-title Change Password
          button.btn-close(type="button", data-bs-dismiss="modal")
        .modal-body
          .mb-2.form-group.required-field
            label.form-label(for="oldPassword") Old Password
            input#oldPassword.form-control(type="password", name="oldPassword", placeholder="old password")
            span.text-danger.error-text#oldPassword-error

          .mb-2.form-group.required-field
            label.form-label(for="newPassword") New Password
            input#newPassword.form-control(type="password", name="newPassword", placeholder="new password")
            span.text-danger.error-text#newPassword-error
          .form-check.mt-2
            input#showPasswords.form-check-input(type="checkbox")
            label.form-check-label(for="showPasswords") Show password
        .modal-footer
          button.btn.btn-light.border(type="button", data-bs-dismiss="modal") Cancel
          button#password-save-btn.btn.btn-primary(type="submit") Change
   
script.
 
  document.addEventListener("DOMContentLoaded", function () {
    const passwordModalEl = document.getElementById("changePasswordModal");
    const passwordForm = $("#changePasswordForm");
    
    //-======= Hidden and Show Toggle =============   
    $("#showPasswords").on("change", function () {
       const type = this.checked ? "text" : "password";
       $("#oldPassword, #newPassword").attr("type", type);
    });
    
    passwordModalEl.addEventListener("hidden.bs.modal", function () {
      passwordForm[0].reset();
      passwordForm.find(".error-text").text("");
    });

    passwordForm.on("submit", async (event) => {
      event.preventDefault();
      const btn = $("#password-save-btn");
      const formData = new FormData(event.currentTarget);

      // ===== Validation =====
      let isValid = true;
      const oldPasswordError = $("#oldPassword-error");
      const newPasswordError = $("#newPassword-error");

      oldPasswordError.text("");
      newPasswordError.text("");

      if ((formData.get("oldPassword") || "").trim() === "") {
        oldPasswordError.text("This is Required");
        isValid = false;
      }
      if ((formData.get("newPassword") || "").trim() === "") {
        newPasswordError.text("This is Required");
        isValid = false;
      }
      if (!isValid) return;

      try {
        const data = Object.fromEntries(formData);
        setButtonLoading(btn, true, "Change");

        const response = await fetch("/changePasswordApi", {
          method: "PATCH",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(data)
        });

        if (!(response.headers.get("content-type") || "").includes("application/json")) {
          throw new Error("Server returned " + response.status + ". Check the route /changePasswordApi");
        }
        const res_data = await response.json();

        if (!res_data.success) {
          if (Array.isArray(res_data.errors) && res_data.errors.length) {
            showToasts(res_data.errors.map((e) => e.message));
          } else {
            showToast(res_data.message || "Something went wrong", "danger");
          }
        } else {
          showToast(res_data.message || "Password changed", "success");
          bootstrap.Modal.getOrCreateInstance(passwordModalEl).hide();
        }
      } catch (error) {
        showToast(error.message || "Something went wrong", "danger");
      } finally {
        setButtonLoading(btn, false, "Change");
      }
    });
  });