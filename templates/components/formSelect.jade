mixin formSelect(opts)
  - const o = Object.assign({ required: false, options: [], placeholder: 'Select' }, opts)
  - const inputId = o.id || o.name
  if o.label
    label.form-label(for=inputId)= o.label
  select.form-select(name=o.name, id=inputId)&attributes(attributes)
    if o.showPlaceholder !== false
      option(value='', disabled=o.required, selected=!o.selected)= o.placeholder
    each opt in o.options
      - const val = (typeof opt === 'object') ? opt.value : opt
      - const text = (typeof opt === 'object') ? opt.label : opt
      - const status = (typeof opt === 'object') ? opt.status : null
      option(value=val, selected=(val === o.selected),data-status=status)= text