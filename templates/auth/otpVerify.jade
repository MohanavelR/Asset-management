extends ../layout/base

block title 
   title  OTP Verification | #{appName}

block content 
  include includes/header
  div.container 
    div.row.justify-content-center.align-items-center.min-vh-100
       div.col-md-5.col-12
        div.rounded.px-5.py-3.app-border-secondary.app-bg-secondary
          h2.mt-2.text-center.app-text-primary OTP Verification
          form#otp-form.login-form.mb-3
            //-===================OTP field==================
            div.form-group.required-field
               input.form-control(type="text",name="otp",id="otp",placeholder="Enter OTP")
               span.text-danger#otp-error.error-text  

            div.col-12.my-4
                button.btn.btn-primary.w-100#otp-submit-btn Submit   
            div.text-center
              a(href="/login") <- Back 
block scripts
     script.
        
        //- ==========  OTP VERIFICATION API==============
        $("#otp-form").on("submit",async(event)=>{
           const otpSubmitBtn=$("#otp-submit-btn")
           try{
            setButtonLoading(otpSubmitBtn, true, "Submit");

            event.preventDefault()

            const formData=new FormData(event.currentTarget)
            let isValid=true
            const otpError= $("#otp-error")
            otpError.text("")
            const otp=formData.get("otp")?.trim()
            if(otp===""){
              otpError.text("This is Required")
              isValid=false
            }
            if(otp && !Number.isInteger(Number(otp))){
              otpError.text("Please enter a valid OTP")
              isValid=false
            }
            
            if(!isValid){
              setTimeout(()=>{
              otpError.text("")
              },3000)
              return
            }
            const data=Object.fromEntries(formData)
            const response = await fetch("/otpVerifyApi",{
              method:"POST",
              headers:{
                "Content-Type":"application/json"
              },
              body:JSON.stringify({...data,loginId:sessionStorage.getItem("loginId")})

            })
            const res_data=await response.json()
            showToast(res_data.message,res_data?.success)
            if(res_data?.success){
              setTimeout(()=>{
             window.location.replace("/set-password")
              },300)
            }
           }
           catch(error){
             showToast(res_data.message)
           }
          finally{
            setButtonLoading(otpSubmitBtn, false, "Submit");
          }
        }) 
        
