extends ../layout/base

block title 
   title  Set Password | #{appName}

block content 
  include includes/header
  div.container 
    div.row.justify-content-center.align-items-center.min-vh-100
       div.col-md-5.col-12
         div.rounded.px-5.py-3.app-border-secondary.app-bg-secondary
          h2.mt-2.text-center.app-text-primary Set Password
          form#setPassword-form.mb-3
            
            //-===============Password Field====================
            div.mb-2.form-group.required-field
              label(for="password-field-1").form-label Enter Password
              input(type="password",id="password-field-1",placeholder="●●●●●●●●").form-control
              span.text-danger#password-field-1-error.error-text  
            
            //-============== Re-Password field===================
            div.mb-2.position-relative.form-group(id="login-password").required-field
              label(for="password-field-2").form-label Enter Re-Password
              input(type="password",id="password-field-2",placeholder="●●●●●●●●").form-control.password-field.pe-4
              span.text-danger#password-field-2-error.error-text  
                
            div.my-3.form-check
              input.form-check-input(type="checkbox",id="show-password")
              label.form-check-label(for="show-password") Show Password    
            div.col-12
              button.btn.btn-primary.w-100#set-submit-btn Submit 
block scripts
    script.
        const passwordInput_1=document.getElementById("password-field-1");
        const passwordInput_2=document.getElementById("password-field-2");
        const showPassword=document.getElementById("show-password");
        
        //-==============Password Hidden and show================== 
        showPassword.addEventListener("change",()=>{
            const isShow=showPassword.checked 
            passwordInput_1.type = isShow ? "text" : "password";
            passwordInput_2.type = isShow ? "text" : "password";
        }) 
        
        //- ===========SET PASSWORD API=============================
        $("#setPassword-form").on("submit",async(event)=>{
             event.preventDefault()
             const SetSubmitBtn=$("#set-submit-btn")
             const password1 = passwordInput_1.value.trim();
             const password2 = passwordInput_2.value.trim();

             try{
                
                setButtonLoading(SetSubmitBtn, true, "Submit");
                let isValid=true
                const passwordField1Error= $("#password-field-1-error")
                const passwordField2Error= $("#password-field-2-error")
                
                passwordField1Error.text("")
                passwordField2Error.text("")
               
                
                if(password1===""){
                  passwordField1Error.text("This is Required")
                  isValid=false
                }
                if(password2===""){
                  passwordField2Error.text("This is Required")
                  isValid=false
                }
                if(password1 && password2 && password1!==password2 ){
                  passwordField2Error.text("Password Not Match")
                  isValid=false
                }
    
                if(!isValid){
                  setTimeout(()=>{
                  passwordField1Error.text("")
                  passwordField2Error.text("")
                  },3000)
                  return
                }
                const response = await fetch("/setPasswordApi",{
                  method:"POST",
                  headers:{
                    "Content-Type":"application/json"
                  },
                   body:JSON.stringify({password:password1,loginId:sessionStorage.getItem("loginId")})
                })
                const res_data=await response.json()
                showToast(res_data.message,res_data?.success)
                if(res_data?.success){
                 sessionStorage.removeItem("loginId") 
                 setTimeout(()=>{
                    window.location.replace("/login")
                  },2000)
                  
                }
             }  
             catch(error){
               showToast(error.message)
             }
             finally{
                 setButtonLoading(SetSubmitBtn, false, "Submit");
             }
              }) 
                  