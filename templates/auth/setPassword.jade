extends ../layout/base

block title 
   title  Login 

block content 
  include includes/header
  div.container 
    div.row.justify-content-center.align-items-center.min-vh-100
       div.col-md-5.col-12
         div.rounded.px-5.pb-5.shadow-lg
          h2.mt-2.text-center Set Password
          form(action="").login-form.mb-3
            div.mb-2.form-group
              label(for="").form-label Enter Password
              input(type="password",id="password-field-1").form-control
            div.mb-2.position-relative.form-group(id="login-password")
              label(for="").form-label Enter Re-Password
              //- span.text-danger.ms-1 * 
              input(type="password",id="password-field-2").form-control.password-field.pe-4
              

            div.my-3.form-check
              input.form-check-input(type="checkbox",id="show-password")
              label.form-check-label(for="") Show Password    
            div.col-12
              button.btn.btn-primary.w-100 Submit 

  block scripts
    script.
         const passwordInput_1=document.getElementById("password-field-1");
         const passwordInput_2=document.getElementById("password-field-2");
         const showPassword=document.getElementById("show-password");

         showPassword.addEventListener("change",()=>{
             const isShow=showPassword.checked 
             passwordInput_1.type = isShow ? "text" : "password";
             passwordInput_2.type = isShow ? "text" : "password";
         }) ;           