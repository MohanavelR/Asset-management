extends ../layout/base

block title 
   title  Forgot Password | #{appName}

block content 
  include includes/header
  div.container 
    div.row.justify-content-center.align-items-center.min-vh-100
       div.col-md-5.col-12
        div.rounded.p-5.shadow-lg
          h2.mt-2.text-center Forgot Password
          form#forgot-form.login-form.mb-3
            div.form-group
               label.form-label(for="loginId") Email/Username 
               input.form-control(type="text",name="loginId",id="loginId")
               span.text-danger#loginId-error.error-text  
            div.col-12.my-4
                button.btn.btn-primary.w-100#forgot-submit-btn Submit   
            div.text-center
              a(href="/login") Back 
block scripts
     script.
         $("#forgot-form").on("submit",async(event)=>{

          const forgotSubmitBtn=$("#forgot-submit-btn")
           try{
            forgotSubmitBtn.html('<div class="spinner-border spinner-border-sm" role="status"><span class="visually-hidden"></span></div>')
            forgotSubmitBtn.prop("disabled", true);
            event.preventDefault()

            const formData=new FormData(event.currentTarget)
            let isValid=true
            const loginIdError= $("#loginId-error")
            loginIdError.text("")
            if(formData.get("loginId")?.trim()===""){
              loginIdError.text("This is Required")
              isValid=false
            }
            if(!isValid){
              setTimeout(()=>{
              loginIdError.text("")
              },3000)
              return
            }
            const data=Object.fromEntries(formData)
            const response = await fetch("/forgotPasswordApi",{
              method:"POST",
              headers:{
                "Content-Type":"application/json"
              },
              body:JSON.stringify(data)
            })
            const res_data=await response.json()
            console.log(res_data)
            showToast(res_data.message)
            if(res_data?.success){
              sessionStorage.setItem("loginId",formData.get("loginId"))
              sessionStorage.setItem("otp",res_data?.otp)
              window.location.href = "/otp-verify";
            }
           }
           catch(error){
             showToast(res_data.message)
           }
          finally{
            forgotSubmitBtn.html("submit")
            forgotSubmitBtn.prop("disabled", false);
          }
         }) 
        
