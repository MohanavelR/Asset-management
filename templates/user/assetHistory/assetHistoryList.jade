extends ../../layout/userLayout
include ../../components/branchSelect
include ../../components/formInput
include ../../components/formSelect
include ../../components/searchBox

block title
    title Asset History | Asset Management

block userContent
   
    - const categoryOptions = (categories || []).map(function (c) { return { value: c.id, label: c.name } })
    - const actionOptions = ['Purchased', 'Issued', 'Returned', 'Re-stocked', 'Scrapped']
    - const today = new Date()
    - const todayStr = today.getFullYear() + '-' + String(today.getMonth() + 1).padStart(2, '0') + '-' + String(today.getDate()).padStart(2, '0')

    div
        div.mb-4
            h2.fw-bold.mb-1.app-text-primary Asset History
            p.app-text-tertiary.small.mb-0 Every purchase, issue, return, re-stock and scrap event. Click History for one asset's full timeline.
        hr
            
        .row.g-2.mb-2
            //-============ Search Filter ========
            .col-lg-4.col-md-12
                +searchBox({
                   id: 'searchInput',
                   label: 'Search',
                   placeholder: 'Search by tag, serial no, make, model...',
                })
        
            //-============ Category Filter ========
            .col-lg-3.col-md-6
                +formSelect({
                    id: 'categoryFilter',
                    label: 'Category',
                    name: 'category',
                    options: categoryOptions,
                    placeholder: 'All Categories'
                })
        
            //-============ Branch Filter ========
            .col-lg-3.col-md-6
                +branchSelect({
                    id: 'branchFilter',
                    label: 'Branch',
                    placeholder: 'All Branches'
                })
        
            //-============ Action Filter ========
            .col-lg-2.col-md-6
                +formSelect({
                    id: 'actionFilter',
                    label: 'Action',
                    name: 'action',
                    options: actionOptions,
                    placeholder: 'All Actions'
                })
        
      
       
            //-============ From Date ========
            .col-lg-2.col-md-6
                +formInput({
                    id: 'fromDate',
                    label: 'From',
                    name: 'fromDate',
                    type: 'date'
                })(title='From date', max=todayStr)
        
            //-============ To Date ========
            .col-lg-2.col-md-6
                +formInput({
                    id: 'toDate',
                    label: 'To',
                    name: 'toDate',
                    type: 'date'
                })(title='To date', max=todayStr)
        
            
            //- ======== Reset Filters ========
            .col-lg-1.col-md-12.d-flex.flex-column.gap-1
                label.form-label.mb-0 Reset
                button#resetFilters.btn.btn-light.border.w-100(type='button', title='Reset')
                    i.fa-solid.fa-rotate-left
        
        hr    
        //- ======== History Table ========
        .card.app-bg-secondary.app-border-primary
                .card-body
                    .table-responsive
                        table#historyTable.table.table-hover.align-middle.app-table.w-100
                          thead
                              tr
                                  th Date
                                  th Asset Tag
                                  th Asset
                                  th Action
                                  th Employee
                                  th Status Change
                                  th Timeline
                          tbody#historyTableBody
                              //- Error
                              tr#historyError.d-none
                                  td.text-center.py-4(colspan='7')
                                      i.fa-solid.fa-triangle-exclamation.fa-2x.text-danger
                                      p.mt-2.mb-0.text-danger Unable to load asset history.

block scripts
    script(src='/js/assetHistory.js')
    script.
        $("#resetFilters").on("click", function () {
            $("#searchInput, #categoryFilter, #branchFilter, #actionFilter, #fromDate, #toDate").val("");
            table.ajax.reload();
        });