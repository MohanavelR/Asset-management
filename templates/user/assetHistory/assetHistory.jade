extends ../../layout/userLayout
include ../../components/informationBox
include ../../components/statCard

block title
    title Asset History | Asset Management

block userContent
    - const a = asset
    - const money = function (v) { return Number(v || 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) }
    - const dt = function (v) { return v ? v.split('-').reverse().join('-') : '-' }
    - const statusColors = { 'In Stock': 'success', 'Issued': 'primary', 'Returned': 'warning', 'Scrapped': 'danger' }
    - const actionColors = { 'Purchased': 'secondary', 'Issued': 'primary', 'Returned': 'warning', 'Re-stocked': 'success', 'Scrapped': 'danger' }
    - const actionIcons = { 'Purchased': 'fa-cart-shopping', 'Issued': 'fa-user-check', 'Returned': 'fa-rotate-left', 'Re-stocked': 'fa-box', 'Scrapped': 'fa-ban' }

    div
        .d-flex.justify-content-between.align-items-center
            .d-flex.align-items-center
                a.app-text-primary.me-3.fs-3(href='/assetHistory', title='Back')
                    i.fas.fa-arrow-left
                h2.app-text-primary.mb-0 Asset History
            div
                if a.status !== 'Scrapped'
                    a.btn.btn-outline-primary(href='/assets/view/' + a.id)
                        i.fas.fa-eye.me-1
                        | Asset Details
        hr.app-border-primary

        //- ======== Asset summary ========
        .row.g-4.mb-4
            .col-lg-6
                +informationBox('fas fa-laptop', 'Asset Information', [
                    { field: 'Asset Tag', value: a.assetTag },
                    { field: 'Serial No', value: a.serial_no },
                    { field: 'Asset',     value: a.make + ' ' + a.model },
                    { field: 'Category',  value: a.categoryInfo ? a.categoryInfo.name : '' },
                    { field: 'Status',    value: a.status, badge: statusColors[a.status] || 'secondary' }
                ], { cls: 'h-100 mb-0', labelWidth: '40%' })

            .col-lg-6
                +informationBox('fas fa-receipt', 'Purchase & Location', [
                    { field: 'Branch',        value: a.branch },
                    { field: 'Vendor',        value: a.vendor },
                    { field: 'Purchase Date', value: dt(a.acqDate) }
                ], { cls: 'h-100 mb-0', labelWidth: '40%' })

        
        //- ======== Timeline ========
        .card.app-bg-secondary.app-border-primary
            .card-header.app-bg-tertiary.app-border-primary.app-text-primary.fw-medium
                i.fas.fa-clock-rotate-left.me-2.app-text-tertiary
                | Timeline
            .card-body
                if history.length
                    ul.tl
                        each h in history
                            li(class='tl-' + (actionColors[h.action] || 'secondary'))
                                span.tl-icon
                                    i.fa-solid(class=actionIcons[h.action] || 'fa-circle')
                                .tl-date.app-text-secondary= dt(h.actionDate)
                                .tl-text.app-text-primary
                                    strong= h.action
                                    if h.employee
                                        |  · #{h.employee.name}
                                    if h.reason
                                        |  · #{h.reason}
                                    if h.amount !== null && h.amount !== undefined
                                        |  · #{money(h.amount)}
                                    .small.app-text-secondary
                                        i.fa-solid.fa-arrow-right-arrow-left.me-2
                                        | #{h.fromStatus || 'New'} → #{h.toStatus}
                                    if h.remarks
                                        .small.fst-italic.app-text-tertiary= h.remarks
                else
                    p.app-text-secondary.text-center.mb-0 No history recorded yet