extends ../../layout/userLayout
include ../../components/branchSelect
include ../../components/formInput
include ../../components/formSelect
include ../../components/formTextarea
include ../../components/searchBox

block title
    title Return Assets | Asset Management

block userContent
    - const categoryOptions = (categories || []).map(function (c) { return { value: c.id, label: c.name } })
    - const issuedOptions = (issues || []).map(function (i) { return { value: String(i.asset.id), label: i.asset.assetTag + ' - ' + i.asset.make + ' ' + i.asset.model + ' (' + i.employee.name + ')' } })

    div
        //- ========== Header =============
        .d-flex.flex-column.flex-sm-row.justify-content-sm-between.align-items-start.align-items-sm-center.mb-4
            div
                h2.fw-bold.mb-1.app-text-primary Return Assets
                p.app-text-tertiary.small.mb-0 Receive issued assets back from employees and view returned asset records
            div.mt-3.mt-sm-0
                button.btn.btn-primary(type='button', data-bs-toggle='modal', data-bs-target='#returnModal')
                    i.fa-solid.fa-rotate-left
                    |  Return Asset
        hr

        .row.g-2.mb-3
            //-============ Search Filter ========
            .col-lg-4.col-md-12
                +searchBox({
                   id: 'searchInput',
                   label: 'Search',
                   placeholder: 'Search by tag, serial no, make, model...',
                })
            //-============ Category Filter ========
            .col-lg-2.col-md-6
                +formSelect({
                    id: 'categoryFilter',
                    label: 'Category',
                    name: 'category',
                    options: categoryOptions,
                    placeholder: 'All Categories'
                })
            
            //-============ Branch Filter ========
            .col-lg-2.col-md-6
                +branchSelect({
                    id: 'branchFilter',
                    label: 'Branch',
                    placeholder: 'All Branches'
                })


            //-============ Reason Filter ========
            .col-lg-2.col-md-6
                +formSelect({
                    id: 'reasonFilter',
                    label: 'Reason',
                    name: 'reasonFilter',
                    options: reasons,
                    placeholder: 'All Reasons'
                })

            //- ======== Reset Filters ========
            .col-lg-1.col-md-12.d-flex.flex-column.gap-1
                label.form-label.mb-0 Reset
                button#resetFilters.btn.btn-light.border.w-100(type='button', title='Reset')
                    i.fa-solid.fa-rotate-left
        hr
        //- ======== Return Table ========
        .card.app-bg-secondary.app-border-primary
            .card-body
                .table-responsive
                    table#returnTable.table.table-hover.align-middle.app-table.w-100
                        thead
                            tr
                                th Asset Tag
                                th Asset
                                th Employee
                                th Issue Date
                                th Return Date
                                th Reason
                                th Remarks
                        tbody#returnTableBody
                            //- Error
                            tr#returnError.d-none
                                td.text-center.py-4(colspan='7')
                                    i.fa-solid.fa-triangle-exclamation.fa-2x.text-danger
                                    p.mt-2.mb-0.text-danger Unable to load returned assets.

    //- ======== Return Modal ========
    #returnModal.modal.fade(tabindex='-1', aria-hidden='true')
        .modal-dialog.modal-lg
            .modal-content
                form#returnForm
                    .modal-header
                        h5.modal-title Return Asset
                        button.btn-close(type='button', data-bs-dismiss='modal')
                    .modal-body
                        .row.g-3
                            //- ====== Issued Asset ======
                            .col-md-6.form-group.required-field
                                +formSelect({
                                    label: 'Issued Asset',
                                    name: 'assetId',
                                    options: issuedOptions,
                                    selected: selectedAssetId ? String(selectedAssetId) : '',
                                    required: true,
                                    placeholder: 'Select asset'
                                })

                            //- ====== Reason ======
                            .col-md-6.form-group.required-field
                                +formSelect({
                                    label: 'Reason for Return',
                                    name: 'reason',
                                    options: reasons,
                                    required: true,
                                    placeholder: 'Select reason'
                                })

                            //- ====== Return Date ======
                            .col-md-6.form-group.required-field
                                +formInput({
                                    label: 'Return Date',
                                    name: 'returnDate',
                                    type: 'date',
                                    value: today,
                                    required: true
                                })(max=today)

                            //- ====== Remarks ======
                            .col-12.form-group
                                +formTextarea({
                                    label: 'Remarks',
                                    name: 'remarks',
                                    rows: 2,
                                    placeholder: 'Required when the reason is Other'
                                })
                    .modal-footer
                        button.btn.btn-light.border(type='button', data-bs-dismiss='modal') Cancel
                        button#return-save-btn.btn.btn-primary(type='submit') Return

block scripts
    script(src='/js/return.js')
    script.
        $("#resetFilters").on("click", function () {
           $("#searchInput, #categoryFilter, #branchFilter, #reasonFilter").val("");
           table.ajax.reload();
        });