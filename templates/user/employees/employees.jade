extends ../../layout/userLayout
include ../../components/formInput
include ../../components/formSelect
include ../../components/branchSelect
include ../../components/searchBox

block title 
    title  Employees | Asset Management 
block userContent 
  div
      //- =========== Header=============
      .d-flex.flex-column.flex-sm-row.justify-content-sm-between.align-items-start.justify-content-start.align-items-sm-center.mb-4
              div 
                 h2.fw-bold.mb-1.app-text-primary Employees
                 p.app-text-tertiary.small.mb-0 Manage employee records, create new employees, and update existing employee details
              div.mt-3.mt-md-0
              a(href="/employees/add").btn.btn-primary 
                i.fa-solid.fa-plus
                |  Add Employee 
      hr   
     
      .row.g-3.justify-content-between
       
        //-========Search Filter===========   
        .col-lg-4.col-md-6
          +searchBox({
             id: 'searchInput',
             label: 'Search',
             name: 'search',
             placeholder: 'Name, email, phone...',
          })

         //-==========Branch Filter============     
        .col-md-3   
          +branchSelect({ 
          placeholder: 'Select branch',
          id: 'branchFilter',
        })
        
        //-==========Status Filter============ 
        .col-md-3
           +formSelect({
            id: 'statusFilter',
            label: 'Status',
            name: 'status',
            options: ['Active', 'Inactive'],
            selected: 'Active',
            placeholder: 'All'
            })
        //- ======Reset Filters===========
        .col-lg-1.col-md-12.d-flex.flex-column.gap-1
          span Reset
          button#resetFilters.btn.btn-light.border.w-100(type='button', title='Reset')
            i.fa-solid.fa-rotate-left  
        
    
        
             
        hr
      
      //-==================Employee Table Management==================
      .card.app-border-secondary.app-bg-secondary
              .card-body
                  .table-responsive
                      table#employeeTable.table.table-striped.table-hover.w-100
                          thead
                              tr
                                  th Emp ID
                                  th Name
                                  th Email
                                  th Phone
                                  th Department
                                  th Designation
                                  th Branch
                                  th Status
                                  th Action 
                          tbody#employeeTableBody
                             //-==========Error State==========
                             tr#employeeError.d-none
                                td.text-center.py-4(colspan="9")
                                   i.fa-solid.fa-triangle-exclamation.fa-2x.text-danger
                                   p.mt-2.mb-0.text-danger
                                             | Unable to load employees.


block scripts
  script(src="/js/employees.js")
  script.
    
    //============ Delete API================
    async function deleteEmployee(id) {
         if (!id) return;
         if (!confirm("Are you sure you want to delete this employee?")) return;
         try {
           const response = await fetch(`/deleteEmployeeApi/${id}`, { method: "DELETE" });
           const res_data = await response.json();
       
           if (res_data.success) {
             showToast(res_data.message || "Deleted successfully", "success");
             $("#employeeTable").DataTable().ajax.reload(null, false);
           } else {
             showApiError(res_data);
           }
         } catch (error) {
           showToast(error.message, "danger");
         }
    }           
    //- =========Reset============== 
    function resetFilter() {
       $("#searchInput").val("");
       $("#statusFilter").val("");
       $("#branchFilter").val("");
       table.ajax.reload();
    }
    $("#resetFilters").on("click", resetFilter);                                      
                           