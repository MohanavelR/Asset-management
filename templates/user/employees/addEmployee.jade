extends ../../layout/userLayout
include ../../components/branchSelect.jade
include ../../components/formInput.jade
include ../../components/formSelect.jade

block userContent

  - const e = employee || {}
  
  //- ======== Header ================
  .d-flex.align-items-center.mb-4.mt-4
    a.text-dark.me-3.fs-3(href='/employees', title='Back')
      i.fas.fa-arrow-left
    h3.mb-0= employee ? 'Update Employee' : 'Add Employee'
  hr
  
  //-============ Employee Form =================
  form#employeeForm(data-id=e.id).mt-3
    .row.g-3
      //- ====== Employee ID ======
      .col-lg-4.col-md-6.form-group.required-field
        +formInput({
          label: 'Employee ID',
          name: 'employeeId',
          value: employeeId || e.employeeId,
          placeholder: 'Auto generated'
        })(readonly)

      //- ====== Name ======
      .col-lg-4.col-md-6.form-group.required-field
        +formInput({
          label: 'Name',
          name: 'name',
          value: e.name,
          required: true,
          placeholder: 'Enter full name'
        })

      //- ====== Email ======
      .col-lg-4.col-md-6.form-group.required-field
        +formInput({
          label: 'Email',
          name: 'email',
          value: e.email,
          type: 'email',
          required: true,
          placeholder: 'e.g. name@company.com'
        })

      //- ====== Phone ======
      .col-lg-4.col-md-6.form-group.required-field
        +formInput({
          label: 'Phone',
          name: 'phone',
          value: e.phone,
          type: 'tel',
          required: true,
          placeholder: 'e.g. 9876543210'
        })

      //- ====== Department ======
      .col-lg-4.col-md-6.form-group.required-field
        +formInput({
          label: 'Department',
          name: 'department',
          value: e.department,
          placeholder: 'e.g. Sales'
        })

      //- ====== Designation ======
      .col-lg-4.col-md-6.form-group.required-field
        +formInput({
          label: 'Designation',
          name: 'designation',
          value: e.designation,
          placeholder: 'e.g. Manager'
        })

      //- ====== Branch ======
      .col-lg-4.col-md-6.form-group.required-field
        +branchSelect({ 
          selected: e.branch, 
          required: true, 
          placeholder: 'Select branch' 
          })
           

      //- ====== Status ======
      .col-lg-4.col-md-6.form-group
        +formSelect({
          label: 'Status',
          name: 'status',
          options: ['Active', 'Inactive'],
          selected: e.status || 'Active',
          showPlaceholder: false
        })

    .text-end.mt-4
      a.btn.btn-light.border.me-2(href='/employees') Cancel
      button#employee-save-btn.btn.btn-primary(type='submit') Save


block scripts
  script.
     
    //-================= Employee Create API ===================
     const employeeForm=$("#employeeForm")
     employeeForm.on("submit",async(event)=>{
       event.preventDefault()
       const employeeSaveBtn=$("#employee-save-btn")

       try{
         const formData = new FormData(event.currentTarget)
         const data=Object.fromEntries(formData)
         const id=employeeForm.data("id")
         const apiUrl = id?`/updateEmployeeApi/${id}`:"/addEmployeeApi"
         setButtonLoading(employeeSaveBtn, true, "Save");
         
         const response = await fetch(apiUrl,{
          method:id?"PUT":"POST",
          headers:{
            "Content-Type":"application/json"
          },
          body :JSON.stringify(data)
         }) 
         const res_data=await response.json()
         
         console.log(res_data)
         if (!res_data.success) {
            if (Array.isArray(res_data.errors) && res_data.errors.length) {
              showToasts(res_data.errors.map(e => e.message));
            } else {
              showToast(res_data.message || "Something went wrong", "danger")
            }
            } else {
              showToast(res_data.message || "Saved successfully", "success")
              employeeForm[0].reset()         
              setTimeout(()=>{
                window.location.replace("/employees")
              },1000)
              employeeForm.removeData("id")    
            }
       }
       catch(error){
         showToast(error.message || "Something went wrong", "danger")
       }
       finally{
        setButtonLoading(employeeSaveBtn, false, "Save");
       }
     })