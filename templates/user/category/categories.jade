extends ../../layout/userLayout

block title
    title Categories | Asset Management

block userContent
    div.pt-3
        div.d-flex.justify-content-between
            h2 Categories
            div
                button.btn.btn-primary#addCategoryBtn(type='button' onclick="addCategory()" )
                    i.fa-solid.fa-plus
                    |  Categories
        hr
        .row.mb-3
            .col-md-4
                input#searchInput.form-control(type='text', placeholder='Search category...')
        .card
            .card-body
                .table-responsive
                    table#categoryTable.table.table-striped.table-hover.w-100
                        thead
                            tr
                                th #
                                th Name
                                th Description
                                th Created
                                th.text-end Action 
                        tbody#categoryTableBody
                              //-Loading    
                           tr#categoryLoading
                              td.py-4.text-center(colspan=9)
                                 .spinner-border.text-primary(role="status",aria-hidden="true")
                           tr#categoryEmpty.d-none
                              td.text-center.py-4(colspan="9")
                                  i.fas.fa-list.fa-2x.text-muted
                                  p.mt-2.mb-0.text-muted
                                      | No categories found.

                                 //- Error
                           tr#categoryError.d-none
                              td.text-center.py-4(colspan="9")
                                 i.fa-solid.fa-triangle-exclamation.fa-2x.text-danger
                                 p.mt-2.mb-0.text-danger
                                           | Unable to load categories.

 
        //- Category Form
        #categoryModal.modal.fade(tabindex='-1', aria-hidden='true')
            .modal-dialog.modal-dialog-centered
                .modal-content
                    form#categoryForm
                        .modal-header
                            h5.modal-title#categoryModalTitle Add Category
                            button.btn-close(type='button', data-bs-dismiss='modal')
                        .modal-body
                            .mb-3
                                label.form-label(for='categoryName') Category Name
                                    span.text-danger  *
                                input#categoryName.form-control(
                                    type='text',
                                    name='name',
                                    placeholder='e.g. Laptop, Mobile Phone, Drill Machine',
                                    minlength='2',
                                    maxlength='100',
                                    
                                )
                                span.text-danger#name-error.error-text
                            .mb-3
                                label.form-label(for='categoryDesc') Description
                                textarea#categoryDesc.form-control(
                                    name='desc',
                                    rows='3',
                                    placeholder='Optional'
                                )
                        .modal-footer
                            button.btn.btn-light(type='button', data-bs-dismiss='modal') Cancel
                            button.btn.btn-primary#categorySubmitBtn(type='submit') Save
block scripts
    script(src="/js/categories.js") 
    script.
        function addCategory() {
            $('#categoryForm').removeAttr('data-id').removeData('id');
            console.log($('#categoryForm').data("id"))
            $('#categoryForm')[0].reset();
            $('#categoryModalTitle').text('Add Category');
            bootstrap.Modal.getOrCreateInstance($('#categoryModal')[0]).show();
        }
    
        function editCategory(category) {
            $('#categoryForm').attr('data-id', category.id).data('id', category.id);
            $('#categoryName').val(category.name);
            $('#categoryDesc').val(category.desc || '');
            $('#categoryModalTitle').text('Edit Category');
            bootstrap.Modal.getOrCreateInstance($('#categoryModal')[0]).show();
        }
        async function deleteCategory(id) {
           if(!id){
               return
           }
           try{
               const isOk = confirm("Are you sure you want to delete this category?\n\n" +"Deletion may fail if assets are linked to this category.");
               if(isOk){
                   const response = await fetch(`/asset-categoriesApi/${id}`, {
                               method: "DELETE"
                   })
                   const res_data=await response.json()
                   if(res_data.success){
                       showToast(res_data.message,"success")
                       $("#categoryTable").DataTable().ajax.reload(null, false);
                   }
                   else{
                       showToast(res_data.message,"danger")
                   }
               } 
           }
           catch(error){
                  showToast(error.message,"danger")
   
           }
   
        }                                      
   