extends ../../layout/userLayout
include ../../components/formInput
include ../../components/formSelect
include ../../components/formTextarea
include ../../components/searchBox

block title
    title Categories | Asset Management

block userContent
    div
        .d-flex.flex-column.flex-sm-row.justify-content-sm-between.align-items-start.justify-content-start.align-items-sm-center.mb-4
            div
                h2.fw-bold.mb-1.app-text-primary Categories
                p.app-text-tertiary.small.mb-0 Manage asset categories, create new categories, and update existing category details
            div.mt-3.mt-md-0
                button#addCategoryBtn.btn.btn-primary(type='button', onclick='addCategory()')
                    i.fa-solid.fa-plus
                    |  Categories
        hr

        //- ======== Search Filter ==========
        .row.mb-3
            .col-md-4 
              +searchBox({
                 id: 'searchInput',
                 label: 'Search',
                 name: 'search',
                 placeholder: 'Name',
              })
        hr        

        //- ========= Category Table ==========
        .card.app-bg-secondary.app-border-primary
            .card-body
                .table-responsive
                    table#categoryTable.table.table-striped.table-hover.w-100
                        thead
                            tr
                                th #
                                th Name
                                th Description
                                th Created
                                th.text-end Action
                        tbody#categoryTableBody
                            //- Error
                            tr#categoryError.d-none
                                td.text-center.py-4(colspan='5')
                                    i.fa-solid.fa-triangle-exclamation.fa-2x.text-danger
                                    p.mt-2.mb-0.text-danger Unable to load categories.

        //- ========= Category Form  ==========
        #categoryModal.modal.fade(tabindex='-1', aria-hidden='true')
            .modal-dialog.modal-dialog-centered
                .modal-content
                    form#categoryForm
                        .modal-header
                            h5#categoryModalTitle.modal-title Add Category
                            button.btn-close(type='button', data-bs-dismiss='modal')

                        .modal-body
                            //- ====== Name ======
                            .mb-3.form-group.required-field
                                +formInput({
                                    id: 'categoryName',
                                    label: 'Category Name',
                                    name: 'name',
                                    placeholder: 'e.g. Laptop'
                                })(minlength='2', maxlength='100')
                                span#name-error.text-danger.error-text

                            //- ====== Description ======
                            .mb-3.form-group
                                +formTextarea({
                                    id: 'categoryDesc',
                                    label: 'Description',
                                    name: 'desc',
                                    placeholder: 'Optional'
                                })

                        .modal-footer
                            button.btn.btn-light(type='button', data-bs-dismiss='modal') Cancel
                            button#categorySubmitBtn.btn.btn-primary(type='submit') Save

block scripts
    script(src="/js/categories.js") 
    script.
       //-============= Open Modal(Add Based)==============  
        function addCategory() {
            $('#categoryForm').removeAttr('data-id').removeData('id');
            console.log($('#categoryForm').data("id"))
            $('#categoryForm')[0].reset();
            $('#categoryModalTitle').text('Add Category');
            bootstrap.Modal.getOrCreateInstance($('#categoryModal')[0]).show();
        }
        //- =========== Open Modal (Edit Based)==============
    
        function editCategory(category) {
            $('#categoryForm').attr('data-id', category.id).data('id', category.id);
            $('#categoryName').val(category.name);
            $('#categoryDesc').val(category.desc || '');
            $('#categoryModalTitle').text('Edit Category');
            bootstrap.Modal.getOrCreateInstance($('#categoryModal')[0]).show();
        }
        
        //- ========== Delete API==================
        async function deleteCategory(id) {
             if (!id) return;
           
             const isOk = confirm(
               "Are you sure you want to delete this category?\n\n" +
               "Deletion may fail if assets are linked to this category."
             );
             if (!isOk) return;
           
             try {
               const response = await fetch(`/asset-categoriesApi/${id}`, { method: "DELETE" });
               const res_data = await response.json();
           
               if (res_data.success) {
                 showToast(res_data.message || "Deleted successfully", "success");
                 $("#categoryTable").DataTable().ajax.reload(null, false);
               } else {
                 showApiError(res_data);
               }
             } catch (error) {
               showToast(error.message, "danger");
             }
        }                                    
   