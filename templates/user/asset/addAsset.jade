extends ../../layout/userLayout

block userContent

  - const a = asset || {}

  .d-flex.align-items-center.mb-4.mt-4
    a.text-dark.me-3.fs-3(href='/assets', title='Back')
      i.fas.fa-arrow-left
    h3.mb-0= asset ? 'Update Asset' : 'Add Asset'

  form#assetForm(data-id=a.id)
    .row.g-3
      .col-lg-4.col-md-6
        label.form-label Asset ID
        input.form-control(name='id', value=a.id, readonly=!!asset, required)

      .col-lg-4.col-md-6
        label.form-label Serial Number
        input.form-control(name='serial_no', value=a.serial_no, required)

      .col-lg-4.col-md-6
        label.form-label Category
        select.form-select(name='category', required)
          option(value='') Select category
          each c in categories
            option(value=c.id, selected=a.category === c.id)= c.name

      .col-lg-4.col-md-6
        label.form-label Make
        input.form-control(name='make', value=a.make, maxlength='100', required)

      .col-lg-4.col-md-6
        label.form-label Model
        input.form-control(name='model', value=a.model, maxlength='100', required)

      .col-lg-4.col-md-6
        label.form-label Vendor
        input.form-control(name='vendor', value=a.vendor, maxlength='100', required)

      .col-lg-4.col-md-6
        label.form-label Acquisition Date
        input.form-control(type='date', name='acqDate', value=a.acqDate, required)

      .col-lg-4.col-md-6
        label.form-label Acquisition Price
        input.form-control(type='number', name='acqPrice', value=a.acqPrice, min='0', step='0.01', required)

      .col-lg-4.col-md-6
        label.form-label Branch
        input.form-control(name='branch', value=a.branch, maxlength='100', required)

      .col-lg-4.col-md-6
        label.form-label Status
        select.form-select(name='status')
          each s in ['In Stock', 'Issued', 'Repair', 'Scrapped']
            option(value=s, selected=a.status === s)= s

      .col-lg-4.col-md-6
        label.form-label Issued Date
        input.form-control(type='date', name='issuedDate', value=a.issuedDate)

      .col-lg-4.col-md-6
        label.form-label Return Date
        input.form-control(type='date', name='returnDate', value=a.returnDate)

      .col-lg-4.col-md-6
        label.form-label Scrapped Date
        input.form-control(type='date', name='scrappedDate', value=a.scrappedDate)

      .col-12
        label.form-label Specifications
        textarea.form-control(name='specifications', rows='3')= a.specifications

    .text-end.mt-4
      a.btn.btn-light.border.me-2(href='/assets') Cancel
      button.btn.btn-primary(type='submit')= asset ? 'Update' : 'Save'

  script.
    const form = document.getElementById('assetForm');

    form.addEventListener('submit', async (ev) => {
      ev.preventDefault();

      const id = form.dataset.id;

      const res = await fetch(
        id ? '/api/assets/' + id : '/api/assets',
        {
          method: id ? 'PUT' : 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(Object.fromEntries(new FormData(form)))
        }
      );

      const data = await res.json();

      if (res.ok) {
        window.location.href = '/assets';
      } else {
        // show every field error, not just the general message
        const details = (data.errors || []).map(e => e.message).join('\n');
        alert(details ? data.message + ':\n' + details : data.message);
      }
    });