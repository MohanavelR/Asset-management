extends ../../layout/userLayout
include ../../components/branchSelect
include ../../components/formInput
include ../../components/formSelect
include ../../components/formTextarea
include ../../components/searchBox

block title
    title Scrap Assets | Asset Management

block userContent
    //- Options as { value, label } for formSelect
    - const categoryOptions = (categories || []).map(function (c) { return { value: c.id, label: c.name } })
    - const assetOptions = (assets || []).map(function (a) { return { value: String(a.id), status: a.status, label: a.assetTag + ' - ' + a.make + ' ' + a.model + ' (' + a.branch + ') - ' + a.status } })

    div
        //- ================== Header ================= 
        .d-flex.flex-column.flex-sm-row.justify-content-sm-between.align-items-start.align-items-sm-center.mb-4
            div
                h2.fw-bold.mb-1.app-text-primary Scrap Assets
                p.app-text-tertiary.small.mb-0 Scrap assets that are no longer usable, or move them back to stock
            div.mt-3.mt-sm-0
                button.btn.btn-danger(type='button', data-bs-toggle='modal', data-bs-target='#scrapModal')
                    i.fa-solid.fa-ban
                    |  Scrap / Re-stock
        hr

        .row.g-2.mb-3
            //-============ Search Filter ========
            .col-lg-4.col-md-12
                +searchBox({
                   id: 'searchInput',
                   label: 'Search',
                   placeholder: 'Search by tag, serial no, make, model...',
                })

            //-============ Category Filter ========
            .col-lg-3.col-md-6
                +formSelect({
                    id: 'categoryFilter',
                    label: 'Category',
                    name: 'category',
                    options: categoryOptions,
                    placeholder: 'All Categories'
                })

            //-============ Branch Filter ========
            .col-lg-3.col-md-6
                +branchSelect({
                    id: 'branchFilter',
                    label: 'Branch',
                    placeholder: 'All Branches'
                })

            //- ======== Reset Filters ========
            .col-lg-2.col-md-12.d-flex.flex-column.gap-1
                label.form-label.mb-0 Reset
                button#resetFilters.btn.btn-light.border.w-100(type='button', title='Reset')
                    i.fa-solid.fa-rotate-left
        hr
        //- ======== Scrap Table ========
        .card.app-bg-secondary.app-border-primary
            .card-body
                .table-responsive
                    table#scrapTable.table.table-hover.align-middle.app-table.w-100
                        thead
                            tr
                                th Asset Tag
                                th Serial No
                                th Category
                                th Asset
                                th Branch
                                th Scrapped Date
                                th Reason
                                th Remarks
                        tbody#scrapTableBody
                            //- Error
                            tr#scrapError.d-none
                                td.text-center.py-4(colspan='8')
                                    i.fa-solid.fa-triangle-exclamation.fa-2x.text-danger
                                    p.mt-2.mb-0.text-danger Unable to load scrapped assets.

    //- ======== Scrap Modal ========
    #scrapModal.modal.fade(tabindex='-1', aria-hidden='true')
        .modal-dialog.modal-lg
            .modal-content
                form#scrapForm
                    .modal-header
                        h5.modal-title Scrap / Re-stock Asset
                        button.btn-close(type='button', data-bs-dismiss='modal')
                    .modal-body
                        .row.g-3
                            //- ====== Asset ======
                            .col-md-6.form-group.required-field
                                +formSelect({
                                    label: 'Asset (In Stock / Retuned)',
                                    name: 'assetId',
                                    options: assetOptions,
                                    required: true,
                                    placeholder: 'Select asset'
                                })

                            //- ====== Reason ======
                            .col-md-6.form-group
                                +formSelect({
                                    label: 'Reason (for scrap)',
                                    name: 'reason',
                                    options: reasons,
                                    placeholder: 'Select reason'
                                })

                            //- ====== Scrapped Date ======
                            .col-md-6.form-group
                                +formInput({
                                    label: 'Scrapped Date',
                                    name: 'scrappedDate',
                                    type: 'date',
                                    value: today
                                })(max=today)

                            //- ====== Remarks ======
                            .col-12.form-group
                                +formTextarea({
                                    label: 'Remarks',
                                    name: 'remarks',
                                    rows: 2,
                                    placeholder: 'Required when the reason is Other'
                                })
                    .modal-footer
                        button.btn.btn-light.border(type='button', data-bs-dismiss='modal') Cancel
                        button#restock-btn.btn.btn-success(type='button', disabled)
                            i.fa-solid.fa-rotate-left
                            |  Re-stock
                        button#scrap-save-btn.btn.btn-danger(type='submit') Scrap

block scripts
    script(src='/js/scrap.js')
    script.
        $("#resetFilters").on("click", function () {
            $("#searchInput, #categoryFilter, #branchFilter").val("");
            table.ajax.reload();
        });