extends ../../layout/userLayout
include ../../components/formInput.jade
include ../../components/formSelect.jade

block title
  title Assets | Asset Management

block userContent

  - const categoryOptions = (categories || []).map(function (c) { return { value: c.id, label: c.name } })

  div.pt-3
    
    //-============ Header ==============
    .d-flex.flex-column.flex-sm-row.justify-content-sm-between.align-items-start.align-items-sm-center.mb-4
      div
        h2.fw-bold.mb-1.app-text-primary Assets
        p.app-text-tertiary.small.mb-0 Manage assets, track their status, and update asset details
      div.mt-3.mt-sm-0
        a.btn.btn-primary(href='/assets/add')
          i.fa-solid.fa-plus
          |  Add Asset
    hr

    
    .row.g-2.mb-3
      
      //-========== Search Filter===========
      .col-lg-5.col-md-12
        +formInput({
          id: 'searchInput',
          name: 'search',
          label:"Search",
          type: 'search',
          placeholder: 'Search by tag, serial no, make, model, vendor or branch'
        })

      //-========== Category Filter===========
      .col-lg-3.col-md-6
        +formSelect({
          id: 'categoryFilter',
          name: 'category',
          label:"Category" ,
          options: categoryOptions,
          placeholder: 'All Categories'
        })

      //-========== Status Filter===========
      .col-lg-3.col-md-6
        +formSelect({
          id: 'statusFilter',
          name: 'status',
           label:"Status" ,
          options: ['In Stock', 'Issued', 'Returned'],
          placeholder: 'All Status'
        })

      //- ======Reset Filters===========
      .col-lg-1.col-md-12.d-flex.flex-column.gap-1
        span Reset
        button#resetFilters.btn.btn-light.border.w-100(type='button', title='Reset')
          i.fa-solid.fa-rotate-left
    hr
    //- ======== Asset Table ========
    .card.app-bg-secondary.app-border-primary
      .card-body
        .table-responsive
          table#assetTable.table.table-hover.align-middle.app-table.w-100
            thead
              tr
                th Asset Tag
                th Serial No
                th Category
                th Make
                th Model
                th Branch
                th Status
                th Actions
            tbody#assetTableBody
              //- Error
              tr#assetError.d-none
                td.text-center.py-4(colspan='8')
                  i.fa-solid.fa-triangle-exclamation.fa-2x.text-danger
                  p.mt-2.mb-0.text-danger Unable to load assets.

block scripts
  script(src='/js/assets.js')
  script.
   
    //- ==========Delete Api===================
    async function deleteAsset(id) {
      if (!id) {
        return
      }
      try {
        const isOk = confirm("Are you sure you want to delete this asset?\n\n" + "Deletion is not allowed if the asset is issued or has history.")
        if (isOk) {
          const response = await fetch(`/deleteAssetApi/${id}`, {
            method: "DELETE"
          })
          const res_data = await response.json()
          if (res_data.success) {
            showToast(res_data.message, "success")
            $("#assetTable").DataTable().ajax.reload(null, false)
          } else {
            showToast(res_data.message, "danger")
          }
        }
      } catch (error) {
        showToast(error.message, "danger")
      }
    }

    //- =========Reset============== 
    function resetFilter() {
     $("#searchInput").val("");
     $("#categoryFilter").val("");
     $("#statusFilter").val("");
     table.ajax.reload();
    }
    $("#resetFilters").on("click", resetFilter);