extends ../../layout/userLayout
include ../../components/informationBox

block title
    title Asset Details | Asset Management

block userContent
    - const a = asset
    - const money = function (v) { return (v === undefined || v === null || v === '') ? '' : Number(v).toLocaleString('en-IN', { minimumFractionDigits: 2 }) }
    - const dt = function (v) { return v ? new Date(v).toLocaleDateString('en-IN') : '' }
    - const actionColors = { 'Issued': 'primary', 'Returned': 'success', 'Scrapped': 'danger' }
    div.pt-3
        .d-flex.justify-content-between.align-items-center
            .d-flex.align-items-center
                a.app-text-primary.me-3.fs-3(href='/assets', title='Back')
                    i.fas.fa-arrow-left
                h2.app-text-primary.mb-0 Asset Details
            div
                a.btn.btn-outline-primary.me-2(href='/assets/' + 'history/' + a.id)
                    i.fas.fa-history.me-1
                    | Show History
                a.btn.btn-primary(href='/assets/' + a.id + '/edit')
                    i.fas.fa-edit.me-1
                    | Edit Asset
        hr.app-border-primary

        //- 3 column grid
        .row.g-4
            .col-lg-4.col-md-6
                +informationBox('fas fa-laptop', 'Asset Information', [
                    { field: 'Asset Tag',      value: a.assetTag },
                    { field: 'Serial No',      value: a.serial_no },
                    { field: 'Category',       value: a.categoryInfo ? a.categoryInfo.name : '' },
                    { field: 'Make',           value: a.make },
                    { field: 'Model',          value: a.model },
                    { field: 'Branch',         value: a.branch },
                    { field: 'Status',         value: a.status },
                    { field: 'Specifications', value: a.specifications, pre: true }
                ], { cls: 'h-100 mb-0', labelWidth: '40%' })

            .col-lg-4.col-md-6
                +informationBox('fas fa-receipt', 'Purchase & Warranty', [
                    { field: 'Vendor',         value: a.vendor },
                    { field: 'Purchase Date',  value: dt(a.acqDate) },
                    { field: 'Purchase Price', value: money(a.acqPrice) },
                    { field: 'Warranty Start', value: dt(a.warrantyStartDate) },
                    { field: 'Warranty End',   value: dt(a.warrantyEndDate) }
                ], { cls: 'h-100 mb-0', labelWidth: '40%' })

            .col-lg-4.col-md-12
                +informationBox('fas fa-user', 'Current Holder', a.employee ? [
                    { field: 'Employee',    value: a.employee.employeeId + ' - ' + a.employee.name, href: '/employee/view/' + a.employee.id },
                    { field: 'Department',  value: a.employee.department },
                    { field: 'Designation', value: a.employee.designation },
                    { field: 'Issued On',   value: dt(a.issuedDate) }
                ] : [], { cls: 'h-100 mb-0', labelWidth: '40%', empty: 'Not assigned to any employee' })