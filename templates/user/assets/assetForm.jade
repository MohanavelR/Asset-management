extends ../../layout/userLayout

block userContent

  - const a = asset || {}

  .d-flex.align-items-center.mb-4.mt-4
    a.text-dark.me-3.fs-3(href='/assets', title='Back')
      i.fas.fa-arrow-left
    h3.mb-0= asset ? 'Update Asset' : 'Add Asset'
  hr
  form#assetForm(data-id=a.id).mt-3
    .row.g-4

      //- Edit mode only: generated by the system, not editable
      if asset
        .col-lg-4.col-md-6
          label.form-label Asset Tag
          input.form-control(value=a.assetTag, readonly)

        .col-lg-4.col-md-6
          label.form-label Status
          input.form-control(value=a.status, readonly)

      .col-lg-4.col-md-6
        label.form-label Serial Number
        input.form-control(name='serial_no', value=a.serial_no)

      .col-lg-4.col-md-6
        label.form-label Category
        select.form-select(name='category')
          option(value='') Select category
          each c in categories
            option(value=c.id, selected=a.category === c.id)= c.name

      .col-lg-4.col-md-6
        label.form-label Make
        input.form-control(name='make', value=a.make, maxlength='100')

      .col-lg-4.col-md-6
        label.form-label Model
        input.form-control(name='model', value=a.model, maxlength='100')

      .col-lg-4.col-md-6
        label.form-label Vendor
        input.form-control(name='vendor', value=a.vendor, maxlength='100')

      .col-lg-4.col-md-6
        label.form-label Purchase Date
        input.form-control(type='date', name='acqDate', value=a.acqDate)

      .col-lg-4.col-md-6
        label.form-label Purchase Price
        input.form-control(type='number', name='acqPrice', value=a.acqPrice, min='0', step='0.01')

      .col-lg-4.col-md-6
        label.form-label Branch
        input.form-control(name='branch', value=a.branch, maxlength='100')

      .col-lg-4.col-md-6
        label.form-label Warranty Start
        input.form-control(type='date', name='warrantyStartDate', value=a.warrantyStartDate)

      .col-lg-4.col-md-6
        label.form-label Warranty End
        input.form-control(type='date', name='warrantyEndDate', value=a.warrantyEndDate)

      .col-12
        label.form-label Specifications
        textarea.form-control(name='specifications', rows='3')= a.specifications

    .text-end.mt-4
      a.btn.btn-light.border.me-2(href='/assets') Cancel
      button.btn.btn-primary#asset-save-btn(type='submit') Save

block scripts
  script.
    const assetForm = $("#assetForm")

    assetForm.on("submit", async (event) => {
      event.preventDefault()
      const assetSaveBtn = $("#asset-save-btn")

      try {
        const formData = new FormData(event.currentTarget)
        const data = Object.fromEntries(formData)
        const id = assetForm.data("id")
        const apiUrl = id ? `/updateAssetApi/${id}` : "/addAssetApi"

        assetSaveBtn.html('<div class="spinner-border spinner-border-sm" role="status"><span class="visually-hidden"></span></div>')
        assetSaveBtn.prop("disabled", true)

        const response = await fetch(apiUrl, {
          method: id ? "PUT" : "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(data)
        })
        const res_data = await response.json()

        if (!res_data.success) {
          if (Array.isArray(res_data.errors) && res_data.errors.length) {
            showToasts(res_data.errors.map(e => e.message))
          } else {
            showToast(res_data.message || "Something went wrong", "danger")
          }
        } else {
          showToast(res_data.message || "Saved successfully", "success")
          setTimeout(() => {
            window.location.replace("/assets")
          }, 1000)
        }
      } catch (error) {
        showToast(error.message || "Something went wrong", "danger")
      } finally {
        assetSaveBtn.html("Save")
        assetSaveBtn.prop("disabled", false)
      }
    })