extends ../../layout/userLayout
include ../../components/formInput
include ../../components/formSelect
include ../../components/formTextarea

block userContent

  - const a = asset || {}
  - const categoryOptions = (categories || []).map(function (c) { return { value: c.id, label: c.name } })
  - const today = new Date().toISOString().slice(0, 10)
  .d-flex.align-items-center.mb-4.mt-4
    a.app-text-primary.me-3.fs-3(href='/assets', title='Back')
      i.fas.fa-arrow-left
    h3.app-text-primary.mb-0= asset ? 'Update Asset' : 'Add Asset'
  hr.app-border-primary

  form#assetForm.mt-3(data-id=a.id)
    .row.g-4

     
      if asset
        //- ====== Asset Tag ======
        .col-lg-4.col-md-6.form-group
          +formInput({
            id: 'assetTag',
            label: 'Asset Tag',
            value: a.assetTag
          })(readonly)

        //- ====== Status ======
        .col-lg-4.col-md-6.form-group
          +formInput({
            id: 'assetStatus',
            label: 'Status',
            value: a.status
          })(readonly)

      //- ====== Serial Number ======
      .col-lg-4.col-md-6.form-group.required-field
        +formInput({
          label: 'Serial Number',
          name: 'serial_no',
          value: a.serial_no,
          required: true,
          placeholder: 'Enter serial number'
        })

      //- ====== Category ======
      .col-lg-4.col-md-6.form-group.required-field
        +formSelect({
          label: 'Category',
          name: 'category',
          options: categoryOptions,
          selected: a.category,
          required: true,
          placeholder: 'Select category'
        })

      //- ====== Make ======
      .col-lg-4.col-md-6.form-group.required-field
        +formInput({
          label: 'Make',
          name: 'make',
          value: a.make,
          required: true,
          placeholder: 'e.g. Dell'
        })(maxlength='100')

      //- ====== Model ======
      .col-lg-4.col-md-6.form-group.required-field
        +formInput({
          label: 'Model',
          name: 'model',
          value: a.model,
          required: true,
          placeholder: 'e.g. Latitude 5420'
        })(maxlength='100')

      //- ====== Vendor ======
      .col-lg-4.col-md-6.form-group.required-field
        +formInput({
          label: 'Vendor',
          name: 'vendor',
          value: a.vendor,
          placeholder: 'Enter vendor name'
        })(maxlength='100')

      //- ====== Purchase Date ======
      .col-lg-4.col-md-6.form-group.required-field
        +formInput({
          label: 'Purchase Date',
          name: 'acqDate',
          type: 'date',
          value: a.acqDate
        })(max=today)

      //- ====== Purchase Price ======
      .col-lg-4.col-md-6.form-group.required-field
        +formInput({
          label: 'Purchase Price',
          name: 'acqPrice',
          type: 'number',
          value: a.acqPrice,
          placeholder: 'e.g. 55000.00'
        })(min='0', step='0.01')

      //- ====== Branch ======
      .col-lg-4.col-md-6.form-group.required-field
        +formSelect({
          label: 'Branch',
          name: 'branch',
          options: branches,
          selected: a.branch,
          required: true,
          placeholder: 'Select branch'
        })

      //- ====== Warranty Start ======
      .col-lg-4.col-md-6.form-group
        +formInput({
          label: 'Warranty Start',
          name: 'warrantyStartDate',
          type: 'date',
          value: a.warrantyStartDate
        })

      //- ====== Warranty End ======
      .col-lg-4.col-md-6.form-group
        +formInput({
          label: 'Warranty End',
          name: 'warrantyEndDate',
          type: 'date',
          value: a.warrantyEndDate
        })

      //- ====== Specifications ======
      .col-12.form-group
        +formTextarea({
          label: 'Specifications',
          name: 'specifications',
          value: a.specifications,
          rows: 3,
          placeholder: 'Optional'
        })

    .text-end.mt-4
      a.btn.btn-light.border.me-2(href='/assets') Cancel
      button#asset-save-btn.btn.btn-primary(type='submit') Save

block scripts
  script.
  
    const assetForm = $("#assetForm")

    assetForm.on("submit", async (event) => {
      event.preventDefault()
      const assetSaveBtn = $("#asset-save-btn")

      try {
        const formData = new FormData(event.currentTarget)
        const data = Object.fromEntries(formData)
        const id = assetForm.data("id")
        const apiUrl = id ? `/updateAssetApi/${id}` : "/addAssetApi"

        setButtonLoading(assetSaveBtn, true, "Save");

        const response = await fetch(apiUrl, {
          method: id ? "PUT" : "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(data)
        })
        const res_data = await response.json()

        if (!res_data.success) {
          if (Array.isArray(res_data.errors) && res_data.errors.length) {
            showToasts(res_data.errors.map(e => e.message))
          } else {
            showToast(res_data.message || "Something went wrong", "danger")
          }
        } else {
          showToast(res_data.message || "Saved successfully", "success")
          setTimeout(() => {
            window.location.replace("/assets")
          }, 1000)
        }
      } catch (error) {
        showToast(error.message || "Something went wrong", "danger")
      } finally {
        setButtonLoading(assetSaveBtn, false, "Save");
      }
    })