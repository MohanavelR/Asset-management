extends ../../layout/userLayout
include ../../components/formInput
include ../../components/formSelect
include ../../components/formTextarea
include ../../components/branchSelect
include ../../components/searchBox

block title
  title Stock View | Asset Management

block userContent
  - const categoryOptions = (categories || []).map(function (c) { return { value: c.id, label: c.name } })
  
  //- ========== Header =============
  div
    .d-flex.flex-column.flex-sm-row.justify-content-sm-between.align-items-start.align-items-sm-center.mb-4
      div
        h2.fw-bold.mb-1.app-text-primary Stock View
        p.app-text-tertiary.small.mb-0 View available stock by category and branch, and issue assets to employees
      
    hr

   
    .row.g-2.mb-3
      //-========= Search Filter ========
      .col-lg-4.col-md-12
          +searchBox({
             id: 'searchInput',
             label: 'Search',
             placeholder: 'Search by tag, serial no, make, model...',
          })

      //============Category Filter ========
      .col-lg-3.col-md-6
        +formSelect({
          id: 'categoryFilter',
          name: 'category',
          label:"Category",
          options: categoryOptions,
          placeholder: 'All Categories'
        })

      
      .col-lg-3.col-md-6 
                +branchSelect({ 
                  placeholder: 'Select branch' ,
                  id: 'branchFilter',
               })
      
      //- ======Reset Filters===========
      .col-lg-1.col-md-12.d-flex.flex-column.gap-1
        span Reset
        button#resetFilters.btn.btn-light.border.w-100(type='button', title='Reset')
          i.fa-solid.fa-rotate-left  

    hr  

    //-=============Totals by branch ===============
    #branchTotals.row.g-2.mb-3

    //- ======== Stock Table ========
    .card.app-bg-secondary.app-border-primary
      .card-body
        .table-responsive
          table#stockTable.table.table-hover.align-middle.app-table.w-100
            thead
              tr
                th Asset Tag
                th Serial No
                th Category
                th Make
                th Model
                th Branch
                th.text-end Price
            tbody#stackTableBody
              //- Error
              tr#stackError.d-none
                td.text-center.py-4(colspan='8')
                  i.fa-solid.fa-triangle-exclamation.fa-2x.text-danger
                  p.mt-2.mb-0.text-danger Unable to load assets.    
            tfoot
              tr.fw-bold
                th#footLabel(colspan='6') Total
                th#footValue.text-end 0.00

block scripts
  script(src='/js/stock.js')
  script.
    $("#resetFilters").on("click", function () {
       $("#searchInput, #categoryFilter, #branchFilter").val("");
       table.ajax.reload();
    });